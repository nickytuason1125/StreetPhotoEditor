# dependencies / build output
node_modules/
dist/
street-story-curator/frontend/dist/
street-story-curator/src-tauri/target/

# model caches & runtime artifacts (21+ GB)
models/
*.gguf
*.safetensors
*.bin

# CDP browser profile & captures
cdp-shots/profile/
cdp-shots/*.png
cdp-shots/*.log

# python
__pycache__/
*.pyc
.venv/
venv/

# OS
Thumbs.db
.DS_Store

# CDP scratch: probe scripts, captured DOM dumps and boot logs. Working
# notes from a debugging session, not repo content. (profile/, *.png and
# *.log are already covered above.)
cdp-shots/*.txt
cdp-shots/*.mjs
cdp-shots/*.ps1
cdp-shots/*.py
cdp-shots/*.json
cdp-shots/*.html

# One-off sample-run capture from the launcher.
_sample_run*.log

# Headless Chrome profile used for specimen screenshots.
cdp-shots/profile_shot/
